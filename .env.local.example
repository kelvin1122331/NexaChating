# Supabase (required to enable authentication, persistence and server APIs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (server-only; never expose this key to the browser)
OPENAI_API_KEY=your-openai-api-key

# Optional distributed rate limiting (falls back to a bounded in-memory limiter locally)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# OneSignal (optional; push notifications remain disabled until configured)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Secure cron endpoint authentication
CRON_SECRET=replace-with-a-long-random-secret

# App URL used for same-origin checks and email auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
